#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_nonuniform_qualifier : require

// Any-hit alpha/tint handling. Radiance rays only invoke this for true alpha cutout. Shadow rays invoke it
// for cutout, translucent, and water buckets so those materials can pass/tint sunlight without closest-hit.
//  * terrain (per-section): gl_InstanceCustomIndexEXT indexes the section table → index/uv buffers,
//    interpolate the atlas UV, discard below the cutoff (leaves/grass/glass see-through).
//  * entity (ENTITY_BIT): gl_InstanceCustomIndexEXT (low bits) indexes the entity geometry table →
//    interpolate the entity UV, sample the per-prim bindless entity texture, discard transparent texels
//    (so entity cutout — hat/jacket overlays, eyes, capes, … — is see-through). Accepted hits fall
//    through to the closest-hit. Entity geometry is built non-opaque so this runs for it.
struct Prim {
    vec4 normal;
    vec4 tint;
    // {rough, metal, hasS, hasN} for solid/cutout — the array stride must match world.rchit / the
    // uploaded buffer (48 B). TRANSLUCENT-bucket prims repurpose this lane for a precomputed whole-sprite
    // average {r, g, b, a} instead (RtTerrain.emit()/translucentAvgColor) — see BUCKET_TRANSLUCENT below.
    vec4 mat;
};
struct Section {
    uint64_t primAddr;
    uint64_t uvAddr;
    uint triBase[4]; // fixed bucket triangle offsets: solid/cutout/translucent/water
};
struct EntityGeom {
    uint64_t primAddr;
    uint64_t idxAddr;
    uint64_t uvAddr;
    uint64_t dispAddr; // MV data; unused here because any-hit only needs primAddr
    vec4 rigidDisp;
};

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer Prims { Prim p[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Indices { uint i[]; };
layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer UVs { vec2 uv[]; };
layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer SectionTable { Section s[]; };
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer EntityTable { EntityGeom e[]; };

layout(binding = 2, set = 0) uniform sampler2D blockAtlas;
layout(binding = 0, set = 1) uniform sampler2D entityTex[];

// The any-hit only ever needs three scalars per invocation (Section/EntityGeom table addresses +
// frameIndex for the alpha-dither salt), so they're pushed as real inline push constants rather than
// read through the per-frame WorldPush BDA buffer (world.rgen/rchit) — that would cost an extra
// global-memory load just to find the address of the load we actually want.
layout(push_constant) uniform PushAddr {
    uint64_t worldPushAddr;   // unused here; kept so the layout matches world.rgen/rchit/rmiss
    uint64_t tableAddr;
    uint64_t entityTableAddr;
    uint frameIndex;
} pcAddr;

// Shadow ray payload — must match the ShadowRay declared in world.rgen / shadow.rmiss (same location 1).
struct ShadowRay {
    vec3 tint;
    float waterT;
    float escaped;
};
layout(location = 1) rayPayloadInEXT ShadowRay shadowVis;

hitAttributeEXT vec2 attribs;

const float ALPHA_CUTOFF = 0.5;       // terrain (matches the cutout block models)
const float ENTITY_ALPHA_CUTOFF = 0.1; // entities: only discard near-fully-transparent texels
const int ENTITY_BIT = 0x800000;
const int PARTICLE_BIT = 0x400000; // particle billboards share the entity cutout path (geom table + atlas)
const int IDX_MASK = 0x3FFFFF;     // low 22 bits = geom-table index (strips ENTITY_BIT | PARTICLE_BIT)
const uint BUCKET_CUTOUT = 1u;
const uint BUCKET_TRANSLUCENT = 2u;
const uint BUCKET_WATER = 3u;
// Faint baseline extinction added to every translucent hit regardless of its color, so perfectly clear
// glass/ice still dims a shadow ray a little instead of being fully invisible to it (real glass isn't a
// perfect transmitter either). Additive with the color-derived extinction below, not a floor/clamp — a
// tinted pane still absorbs its own color on top of this.
const float TRANSLUCENT_NEUTRAL_EXTINCTION = 0.15;
const float WATER_SHADOW_TINT = 0.5;

// Progressive 8x8 blue-noise-style alpha threshold pattern, with a golden-ratio temporal rotation. This keeps
// translucent entity hits stochastic, but trades per-pixel white noise for a stable spatial distribution
// that temporal upscaling can integrate with less sparkle.
const float ALPHA_DITHER_8X8[64] = float[64](
    0.281250, 0.968750, 0.375000, 0.859375, 0.250000, 0.937500, 0.406250, 0.812500,
    0.593750, 0.187500, 0.734375, 0.046875, 0.578125, 0.218750, 0.703125, 0.015625,
    0.453125, 0.765625, 0.328125, 0.921875, 0.484375, 0.796875, 0.343750, 0.890625,
    0.640625, 0.093750, 0.546875, 0.156250, 0.671875, 0.078125, 0.515625, 0.125000,
    0.265625, 0.953125, 0.421875, 0.828125, 0.296875, 0.984375, 0.390625, 0.843750,
    0.562500, 0.234375, 0.687500, 0.000000, 0.609375, 0.203125, 0.718750, 0.031250,
    0.468750, 0.781250, 0.359375, 0.875000, 0.437500, 0.750000, 0.312500, 0.906250,
    0.656250, 0.062500, 0.500000, 0.140625, 0.625000, 0.109375, 0.531250, 0.171875
);

float alphaDitherThreshold(uint salt) {
    uvec2 p = (uvec2(gl_LaunchIDEXT.xy) + uvec2(salt * 3u, salt * 5u)) & uvec2(7u);
    float base = ALPHA_DITHER_8X8[int(p.y * 8u + p.x)];
    return fract(base + float((pcAddr.frameIndex + salt) & 255u) * 0.61803398875);
}

void main() {
    uint pid = gl_PrimitiveID;
    vec3 bary = vec3(1.0 - attribs.x - attribs.y, attribs.x, attribs.y);

    if ((gl_InstanceCustomIndexEXT & (ENTITY_BIT | PARTICLE_BIT)) != 0) {
        EntityGeom g = EntityTable(pcAddr.entityTableAddr).e[gl_InstanceCustomIndexEXT & IDX_MASK];
        Indices indices = Indices(g.idxAddr);
        UVs uvs = UVs(g.uvAddr);
        uint i0 = indices.i[3u * pid + 0u];
        uint i1 = indices.i[3u * pid + 1u];
        uint i2 = indices.i[3u * pid + 2u];
        vec2 uv = bary.x * uvs.uv[i0] + bary.y * uvs.uv[i1] + bary.z * uvs.uv[i2];
        Prim epr = Prims(g.primAddr).p[pid];
        int texSlot = int(epr.tint.w + 0.5);
        float ealpha = texture(entityTex[nonuniformEXT(texSlot)], uv).a;
        // normal.w flags an alpha-blended (translucent) surface — slime / sulfur-cube shells, ghosts, …
        // (set by RtEntityCapture; 0 for opaque/cutout mobs + particles, which keep the binary cutout).
        if (epr.normal.w > 0.5) {
            uint salt = pid * 1664525u
                    ^ uint(gl_InstanceCustomIndexEXT & IDX_MASK) * 1013904223u
                    ^ floatBitsToUint(gl_HitTEXT);
            if (alphaDitherThreshold(salt) >= clamp(ealpha, 0.0, 1.0)) {
                ignoreIntersectionEXT;
            }
            return;
        }
        if (ealpha < ENTITY_ALPHA_CUTOFF) {
            ignoreIntersectionEXT;
        }
        return;
    }

    Section sec = SectionTable(pcAddr.tableAddr).s[gl_InstanceCustomIndexEXT];
    uint bucket = gl_GeometryIndexEXT;
    // Multi-geom: gl_PrimitiveID restarts per geometry → re-add triBase[bucket].
    // Single-geom (RADV): geometryIndex is always 0 and triBase[0]==0, so tri == gl_PrimitiveID
    // over the packed solid|cutout|translucent|water arrays.
    uint tri = gl_PrimitiveID + sec.triBase[min(bucket, 3u)];
    Prim pr = Prims(sec.primAddr).p[tri];

    // Shadow rays set SkipClosestHit (+ TerminateOnFirstHit). Multi-geom encodes material in
    // geometryIndex; RADV single-geom always hits geometry 0, so re-derive the bucket from prim
    // flags: tint.w 2=glass/ice, 1=water; normal.w>=1.5 marks non-SOLID (cutout/translucent).
    bool shadowRay = (gl_IncomingRayFlagsEXT & gl_RayFlagsSkipClosestHitShaderEXT) != 0u;
    if (bucket == 0u) {
        if (pr.tint.w > 1.5) {
            bucket = BUCKET_TRANSLUCENT;
        } else if (pr.tint.w > 0.5) {
            bucket = BUCKET_WATER;
        } else if (pr.normal.w >= 1.5) {
            bucket = BUCKET_CUTOUT;
        } else {
            // True solid: accept. Radiance continues to closest-hit; shadow terminates on this hit.
            return;
        }
    }

    // Water radiance rays use a closest-hit-only SBT record on multi-geom. Shadow rays (and RADV
    // single-geom radiance any-hit for water) tint sunlight by the biome water color, then keep
    // walking so submerged terrain is lit by colored transmission.
    if (bucket == BUCKET_WATER) {
        if (!shadowRay) {
            return; // radiance: accept, let closest-hit shade the dielectric surface
        }
        shadowVis.tint *= mix(vec3(1.0), pr.tint.rgb, WATER_SHADOW_TINT);
        // Record the NEAREST water crossing (any-hit order is arbitrary) in the dedicated waterT lane. For an
        // underwater shading point this is the exit point of its sun shadow ray, where world.rgen evaluates
        // the wave-refraction caustic. visibility() seeds the -1 sentinel.
        shadowVis.waterT = shadowVis.waterT < 0.0 ? gl_HitTEXT : min(shadowVis.waterT, gl_HitTEXT);
        ignoreIntersectionEXT;
        return;
    }

    // Translucent: radiance accepts (closest-hit does dielectric); shadow absorbs and passes through.
    // pr.mat carries a precomputed whole-sprite average {r,g,b,a} with biome tint baked at pack time.
    if (bucket == BUCKET_TRANSLUCENT) {
        if (!shadowRay) {
            return;
        }
        vec3 avgColor = max(pr.mat.rgb, vec3(1.0e-3));
        vec3 colorExtinction = max(-log(avgColor), vec3(0.0));
        // Neutral floor is flat per-hit dimming, not scaled by alpha (clear glass has low natural alpha).
        shadowVis.tint *= exp(-colorExtinction * pr.mat.a - TRANSLUCENT_NEUTRAL_EXTINCTION);
        ignoreIntersectionEXT;
        return;
    }

    // Cutout geometry: alpha from the atlas. UVs are packed per-triangle corner (3*tri + k).
    UVs uvs = UVs(sec.uvAddr);
    vec2 uv = bary.x * uvs.uv[3u * tri + 0u] + bary.y * uvs.uv[3u * tri + 1u] + bary.z * uvs.uv[3u * tri + 2u];
    if (textureLod(blockAtlas, uv, 0.0).a < ALPHA_CUTOFF) {
        ignoreIntersectionEXT;
    }
}
