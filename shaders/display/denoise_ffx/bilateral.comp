#version 460
//
// Multi-pass-capable 3x3 joint bilateral. Depth + normal edge-stop, relative
// colour weight so SPP-1 HDR noise does not zero every sample.
// Host may run several times with ping-pong buffers for stronger denoise
// without temporal history (no ghost trails).
//
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) readonly uniform image2D inColor;
layout(set = 0, binding = 1, rgba16f) readonly uniform image2D inNormal;
layout(set = 0, binding = 2, r32f)    readonly uniform image2D inDepth;
layout(set = 0, binding = 3, rgba16f) writeonly uniform image2D outColor;

layout(push_constant) uniform BilateralParams {
    float depthSigma;
    float normalSigma;
    float colorSigma;   // relative luma threshold
    float centerWeight; // unused (kept for layout); center always in the 3x3
} pc;

float ffxLuma(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

bool ffxIsSkyByNormal(vec3 n) {
    return length(n) < 0.5;
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(inColor);
    if (pos.x >= size.x || pos.y >= size.y) {
        return;
    }

    vec3 center = imageLoad(inColor, pos).rgb;
    if (any(isnan(center)) || any(isinf(center))) {
        center = vec3(0.0);
    }
    vec3 centerNormal = imageLoad(inNormal, pos).xyz;
    float centerDepth = imageLoad(inDepth, pos).r;

    // Sky / invalid normal: pass through (do not smear into geometry).
    if (ffxIsSkyByNormal(centerNormal)) {
        imageStore(outColor, pos, vec4(center, centerDepth));
        return;
    }

    float depthSigma = max(pc.depthSigma, 1e-4);
    float normalSigma = max(pc.normalSigma, 1e-4);
    float colorSigma = max(pc.colorSigma, 1e-3);
    float centerL = ffxLuma(center);

    vec3 sum = vec3(0.0);
    float weightSum = 0.0;

    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            ivec2 np = pos + ivec2(dx, dy);
            if (np.x < 0 || np.y < 0 || np.x >= size.x || np.y >= size.y) {
                continue;
            }
            vec3 neighborNormal = imageLoad(inNormal, np).xyz;
            if (ffxIsSkyByNormal(neighborNormal)) {
                continue;
            }
            vec3 neighbor = imageLoad(inColor, np).rgb;
            if (any(isnan(neighbor)) || any(isinf(neighbor))) {
                continue;
            }
            float neighborDepth = imageLoad(inDepth, np).r;

            float depthJump = centerDepth - neighborDepth;
            float depthWeight = exp(-(depthJump * depthJump) / (2.0 * depthSigma * depthSigma));

            float ncos = clamp(dot(centerNormal, neighborNormal), -1.0, 1.0);
            float ndiff = 1.0 - ncos;
            float normalWeight = exp(-(ndiff * ndiff) / (2.0 * normalSigma * normalSigma));

            // Relative colour — absolute |Δluma| kills SPP-1 spatial weights.
            float neighborL = ffxLuma(neighbor);
            float colorJump = abs(centerL - neighborL) / max(max(centerL, neighborL), 0.05);
            float colorWeight = exp(-(colorJump * colorJump) / (2.0 * colorSigma * colorSigma));

            float w = depthWeight * normalWeight * colorWeight;
            // Slight spatial falloff so the centre dominates a little.
            float spat = (dx == 0 && dy == 0) ? 1.0 : 0.85;
            w *= spat;
            sum += neighbor * w;
            weightSum += w;
        }
    }

    vec3 result = (weightSum > 1e-6) ? (sum / weightSum) : center;
    if (any(isnan(result)) || any(isinf(result))) {
        result = center;
    }
    imageStore(outColor, pos, vec4(max(result, vec3(0.0)), centerDepth));
}
