// Radiance-style compose after NRD:
//   sky / clear  → clear radiance (path-traced, not NRD)
//   surface      → unpack YCoCg irradiance × albedo (remodulate)
#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba16f) readonly  uniform image2D gDiff;
layout(binding = 1, rgba16f) readonly  uniform image2D gSpec;
layout(binding = 2, rgba16f) readonly  uniform image2D gDiffAlbedo;
layout(binding = 3, rgba16f) readonly  uniform image2D gSpecAlbedo;
layout(binding = 4, rgba16f) readonly  uniform image2D gNormalRough;
layout(binding = 5, r11f_g11f_b10f) readonly  uniform image2D gClearRadiance; // pre-denoise beauty (sky + full frame)
layout(binding = 6, r8)      readonly  uniform image2D gTransparencyMask; // 1.0=transparent, 0.0=opaque
layout(binding = 7, r11f_g11f_b10f) readonly  uniform image2D gTransparentDenoised; // denoised glass/water
layout(binding = 8, r11f_g11f_b10f) writeonly uniform image2D gOut;
layout(binding = 9, rgba16f) readonly uniform image2D gClearEmission;
layout(binding = 10, rgba16f) readonly uniform image2D gTransmission;
layout(binding = 11, rgba16f) readonly uniform image2D gSigmaShadow;
layout(binding = 12, rgba16f) readonly uniform image2D gUnshadowedDirect;
layout(binding = 13, rg8) readonly uniform image2D gDemodulationMask;

layout(push_constant) uniform Push {
    float surfaceGain; // scale NRD surface (default ~0.95)
    float skyGain;     // scale clear/sky (default ~1.12)
    float detailMix;   // 0=no detail injection, 1=full diff visualization (repurposed for debugView)
    uint debugView;    // debug visualization mode (0=render, 8+=extended views)
} pc;

// Must match prepare_nrd_inputs.comp demode floors / material thresholds.
const vec3 kMinDiffAlb = vec3(0.04);
const vec3 kMinSpecAlb = vec3(0.03);
// Multi-tier roughness thresholds (synced with prepare_nrd_inputs.comp)
const float kMirror = 0.02;
const float kWater = 0.08;
const float kSmooth = 0.15;
const float kSemiRough = 0.40;
const float kRough = 0.70;

vec3 yCoCgToLinear(vec3 color) {
    float t = color.x - color.z;
    vec3 r;
    r.y = color.x + color.z;
    r.x = t + color.y;
    r.z = t - color.y;
    return max(r, vec3(0.0));
}

float luma(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(gOut);
    if (pix.x >= size.x || pix.y >= size.y) {
        return;
    }

    vec3 clear = max(imageLoad(gClearRadiance, pix).rgb, vec3(0.0));
    vec4 nr = imageLoad(gNormalRough, pix);
    float rough = clamp(nr.w, 0.0, 1.0);
    float nLen = length(nr.xyz);
    bool sky = nLen < 0.5;
    float transMask = imageLoad(gTransparencyMask, pix).r;

    // Extended debug views (8-14)
    if (pc.debugView >= 8u && pc.debugView <= 14u) {
        vec3 debugOut = vec3(0.0);

        if (pc.debugView == 8u) {
            // Shadow clean vs raw difference (amplified)
            vec3 diffAlb = max(imageLoad(gDiffAlbedo, pix).rgb, kMinDiffAlb);
            vec3 nrdDiff = yCoCgToLinear(imageLoad(gDiff, pix).xyz) * diffAlb;
            vec3 rawDiff = clear; // pre-denoised beauty
            debugOut = abs(nrdDiff - rawDiff) * 5.0; // 5x amplification
        } else if (pc.debugView == 9u) {
            // NRD diffuse clean vs raw diff
            vec3 diffAlb = max(imageLoad(gDiffAlbedo, pix).rgb, kMinDiffAlb);
            vec3 nrdDiff = yCoCgToLinear(imageLoad(gDiff, pix).xyz) * diffAlb;
            debugOut = nrdDiff;
        } else if (pc.debugView == 10u) {
            // NRD specular clean vs raw diff
            vec3 specAlb = max(imageLoad(gSpecAlbedo, pix).rgb, kMinSpecAlb);
            vec3 specLin = yCoCgToLinear(imageLoad(gSpec, pix).xyz);
            vec3 nrdSpec = (rough > 0.22) ? (specLin * specAlb) : specLin;
            debugOut = nrdSpec;
        } else if (pc.debugView == 11u) {
            // ReSTIR reservoir weights heatmap (placeholder - needs reservoir data binding)
            debugOut = vec3(0.5, 0.0, 0.5); // magenta = not implemented
        } else if (pc.debugView == 12u) {
            // Denoiser confidence map (based on luminance consistency)
            vec3 diffAlb = max(imageLoad(gDiffAlbedo, pix).rgb, kMinDiffAlb);
            vec3 nrdDiff = yCoCgToLinear(imageLoad(gDiff, pix).xyz) * diffAlb;
            float nrdLuma = luma(nrdDiff);
            float rawLuma = luma(clear);
            float confidence = 1.0 - clamp(abs(nrdLuma - rawLuma) / max(rawLuma, 0.1), 0.0, 1.0);
            debugOut = vec3(confidence, confidence * 0.5, 0.0); // green-yellow gradient
        } else if (pc.debugView == 13u) {
            // Temporal reprojection validity (sky=red, valid=green, invalid=blue)
            if (sky) {
                debugOut = vec3(1.0, 0.0, 0.0); // red = sky
            } else {
                // Heuristic: low roughness + high normal length = valid temporal
                float validity = clamp(nLen * (1.0 - rough), 0.0, 1.0);
                debugOut = mix(vec3(0.0, 0.0, 1.0), vec3(0.0, 1.0, 0.0), validity);
            }
        } else if (pc.debugView == 14u) {
            // Material roughness classification visualization
            if (sky) {
                debugOut = vec3(0.0, 0.0, 0.0); // black = sky
            } else if (rough <= kMirror) {
                debugOut = vec3(1.0, 1.0, 1.0); // white = mirror
            } else if (rough <= kWater) {
                debugOut = vec3(0.0, 0.5, 1.0); // cyan = water
            } else if (rough <= kSmooth) {
                debugOut = vec3(0.0, 1.0, 0.5); // green = smooth
            } else if (rough <= kSemiRough) {
                debugOut = vec3(1.0, 1.0, 0.0); // yellow = semi-rough
            } else if (rough <= kRough) {
                debugOut = vec3(1.0, 0.5, 0.0); // orange = rough
            } else {
                debugOut = vec3(1.0, 0.0, 0.0); // red = very rough
            }
        }

        imageStore(gOut, pix, vec4(debugOut, 1.0));
        return;
    }

    // Radiance: if clear path (sky), use clear radiance only
    if (sky) {
        float sg = pc.skyGain > 0.0 ? pc.skyGain : 1.15;
        vec3 c = clear * sg;
        if (any(isnan(c)) || any(isinf(c))) c = clear;
        c = min(c, vec3(64.0));
        imageStore(gOut, pix, vec4(c, 1.0));
        return;
    }

    float sg = pc.surfaceGain > 0.0 ? pc.surfaceGain : 1.0;
    vec3 c;

    // Particles still use the specialized transparent bilateral path.
    // Water/glass dielectric interfaces are remodulated from NRD REBLUR like other surfaces
    // so reflections stay temporally stable instead of being replaced by raw beauty.
    if (transMask > 0.5) {
        c = max(imageLoad(gTransparentDenoised, pix).rgb, vec3(0.0)) * sg;
        if (any(isnan(c)) || any(isinf(c))) {
            c = clear; // fallback to raw on failure
        }
    } else {
        // Remodulate denoised irradiance with albedo (opaque + water/glass dielectric).
        vec3 diffAlb = max(imageLoad(gDiffAlbedo, pix).rgb, kMinDiffAlb);
        vec3 specAlb = max(imageLoad(gSpecAlbedo, pix).rgb, kMinSpecAlb);
        // Soft floor for dielectric body fill so dark water columns don't zero out.
        if (rough <= kSmooth) {
            diffAlb = max(diffAlb, vec3(0.12));
            specAlb = max(specAlb, vec3(0.04));
        }
        vec2 demodulated = imageLoad(gDemodulationMask, pix).rg;
        vec3 diff = yCoCgToLinear(imageLoad(gDiff, pix).xyz);
        if (demodulated.r > 0.5) diff *= diffAlb;
        vec3 specLin = yCoCgToLinear(imageLoad(gSpec, pix).xyz);
        vec3 spec = specLin;
        if (demodulated.g > 0.5) spec *= specAlb;
        // SIGMA encodes shadow as sqrt(visibility); unpack exactly once before applying it
        // to the separately classified, already material-weighted direct-light term.
        float sigmaEncoded = clamp(imageLoad(gSigmaShadow, pix).r, 0.0, 1.0);
        float shadow = sigmaEncoded * sigmaEncoded;
        vec3 direct = max(imageLoad(gUnshadowedDirect, pix).rgb, vec3(0.0)) * shadow;
        // Opaque emission is an explicitly classified unfiltered signal. Primary clear radiance
        // is handled by the sky branch above, so surface pixels contain emission only here.
        vec3 emission = max(imageLoad(gClearEmission, pix).rgb, vec3(0.0));
        vec3 transmission = max(imageLoad(gTransmission, pix).rgb, vec3(0.0));
        c = (direct + diff + spec + emission + transmission) * sg;

        // ONLY fall back on true death — never re-inject raw grain over good REBLUR.
        float nrdY = luma(c);
        if (any(isnan(c)) || any(isinf(c)) || nrdY < 1e-8) {
            c = clear;
        }
    }
    if (any(isnan(c)) || any(isinf(c))) {
        c = max(clear, vec3(0.0));
    }
    // Aggressive firefly squash for dark scenes (starfield grain at SPP=1).
    // Two-stage: soft compress moderate spikes, hard clamp extreme outliers.
    float L = luma(c);
    if (L > 2.5) {
        c *= (2.5 + 0.2 * (L - 2.5)) / L;
    }
    L = luma(c);
    if (L > 6.0) {
        c *= 6.0 / L;
    }
    c = min(max(c, vec3(0.0)), vec3(16.0));
    imageStore(gOut, pix, vec4(c, 1.0));
}
