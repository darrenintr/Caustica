// FidelityFX Reflection Denoiser — temporal reproject (Caustica-hosted SPIR-V).
// Lineage: AMD FFX Denoiser 1.2 reflections reproject (disocclusion, neighbourhood
// clamp, thin-history variance boost). Operates on specular radiance only.
#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba16f) readonly  uniform image2D gReflection;  // raw specular
layout(binding = 1, r32f)    readonly  uniform image2D gDepth;
layout(binding = 2, rgba16f) readonly  uniform image2D gNormal;      // xyz normal, w roughness
layout(binding = 3, rgba16f)  readonly  uniform image2D gMotion;      // prefer specular MV when bound
layout(binding = 4, rgba16f) readonly  uniform image2D gHistory;     // rgb history, a = sample count
layout(binding = 5, rgba16f) writeonly uniform image2D gOut;         // rgb reprojected, a = new count

layout(push_constant) uniform Push {
    float invW;
    float invH;
    float depthThreshold;
    float reset; // 1 = hard cut
} pc;

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(gReflection);
    if (pix.x >= size.x || pix.y >= size.y) {
        return;
    }

    vec3 curSpec = imageLoad(gReflection, pix).rgb;
    float curDepth = imageLoad(gDepth, pix).r;
    vec4 nPack = imageLoad(gNormal, pix);
    vec3 curN = normalize(nPack.xyz + 1e-6);
    float rough = clamp(nPack.w, 0.0, 1.0);

    bool noSurface = (length(nPack.xyz) < 1e-4) || (curDepth <= 1e-6);
    // Very rough diffuse-like: little specular energy — passthrough raw (often ~0).
    if (noSurface || pc.reset > 0.5 || rough > 0.95) {
        imageStore(gOut, pix, vec4(curSpec, 1.0));
        return;
    }

    vec2 motionPx = imageLoad(gMotion, pix).xy;
    vec2 prevUv = (vec2(pix) + 0.5 - motionPx) * vec2(pc.invW, pc.invH);
    bool offscreen = any(lessThan(prevUv, vec2(0.0))) || any(greaterThanEqual(prevUv, vec2(1.0)));

    vec3 histSpec = curSpec;
    float histCount = 0.0;
    if (!offscreen) {
        vec2 prevPx = prevUv * vec2(size) - 0.5;
        ivec2 i0 = ivec2(floor(prevPx));
        vec2 f = prevPx - vec2(i0);
        ivec2 c00 = clamp(i0, ivec2(0), size - 1);
        ivec2 c10 = clamp(i0 + ivec2(1, 0), ivec2(0), size - 1);
        ivec2 c01 = clamp(i0 + ivec2(0, 1), ivec2(0), size - 1);
        ivec2 c11 = clamp(i0 + ivec2(1, 1), ivec2(0), size - 1);
        vec4 h00 = imageLoad(gHistory, c00);
        vec4 h10 = imageLoad(gHistory, c10);
        vec4 h01 = imageLoad(gHistory, c01);
        vec4 h11 = imageLoad(gHistory, c11);
        histSpec = mix(mix(h00.rgb, h10.rgb, f.x), mix(h01.rgb, h11.rgb, f.x), f.y);
        histCount = mix(mix(h00.a, h10.a, f.x), mix(h01.a, h11.a, f.x), f.y);

        float histDepth = imageLoad(gDepth, c00).r;
        float depthErr = abs(curDepth - histDepth) / max(curDepth, 1e-3);
        float ndv = abs(curN.z);
        float thresh = mix(pc.depthThreshold * 4.0, pc.depthThreshold, clamp(ndv, 0.0, 1.0));
        // Glossy: tighter depth reject (ghosting is more visible).
        thresh *= mix(0.5, 1.0, rough);
        if (depthErr > thresh) {
            histCount = 0.0;
            histSpec = curSpec;
        }
        vec3 histN = normalize(imageLoad(gNormal, c00).xyz + 1e-6);
        if (dot(curN, histN) < 0.7) {
            histCount = 0.0;
            histSpec = curSpec;
        }
    }

    // 3x3 neighbourhood clamp in current specular (anti-ghost).
    vec3 nMin = curSpec;
    vec3 nMax = curSpec;
    vec3 nSum = vec3(0.0);
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            ivec2 q = clamp(pix + ivec2(dx, dy), ivec2(0), size - 1);
            vec3 s = imageLoad(gReflection, q).rgb;
            nMin = min(nMin, s);
            nMax = max(nMax, s);
            nSum += s;
        }
    }
    // Expand box slightly on rough surfaces (more variance expected).
    vec3 expand = vec3(0.05 + rough * 0.15);
    histSpec = clamp(histSpec, nMin - expand, nMax + expand);

    float alpha = histCount < 1.0 ? 1.0 : mix(0.25, 0.08, clamp(histCount / 16.0, 0.0, 1.0));
    // Mirror-like: more temporal; rough glossy: more current.
    alpha = mix(alpha * 0.7, min(alpha * 1.4, 0.9), rough);
    vec3 outSpec = mix(histSpec, curSpec, alpha);
    // Firefly squash on specular spikes.
    outSpec = min(outSpec, vec3(32.0));
    float outCount = min(histCount + 1.0, 64.0);
    imageStore(gOut, pix, vec4(max(outSpec, vec3(0.0)), outCount));
}
