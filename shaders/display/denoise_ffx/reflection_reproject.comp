// FidelityFX Reflection Denoiser — temporal reproject with depth hierarchy (Caustica-hosted).
// Uses coarse depth mips for more stable disocclusion at grazing angles / large motion.
#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba16f) readonly  uniform image2D gReflection;
layout(binding = 1, r32f)    readonly  uniform image2D gDepth;       // mip0 full-res
layout(binding = 2, rgba16f) readonly  uniform image2D gNormal;      // xyz normal, w roughness
layout(binding = 3, rgba16f) readonly  uniform image2D gMotion;
layout(binding = 4, rgba16f) readonly  uniform image2D gHistory;
layout(binding = 5, rgba16f) writeonly uniform image2D gOut;
// Depth hierarchy (half, quarter, eighth). May be 1x1 placeholders if unused.
layout(binding = 6, r32f)    readonly  uniform image2D gDepthMip1;
layout(binding = 7, r32f)    readonly  uniform image2D gDepthMip2;
layout(binding = 8, r32f)    readonly  uniform image2D gDepthMip3;

layout(push_constant) uniform Push {
    float invW;
    float invH;
    float depthThreshold;
    float reset;
} pc;

float sampleDepthHierarchy(vec2 uv, float motionLenPx) {
    // Larger motion / uncertainty → coarser mip (official uses full hierarchy).
    float level = clamp(motionLenPx * 0.08, 0.0, 3.0);
    ivec2 p0 = ivec2(uv * vec2(imageSize(gDepth)));
    float d0 = imageLoad(gDepth, clamp(p0, ivec2(0), imageSize(gDepth) - 1)).r;
    if (level < 0.5) return d0;

    ivec2 p1 = ivec2(uv * vec2(imageSize(gDepthMip1)));
    float d1 = imageLoad(gDepthMip1, clamp(p1, ivec2(0), max(imageSize(gDepthMip1) - 1, ivec2(0)))).r;
    if (level < 1.5) return mix(d0, d1, clamp(level, 0.0, 1.0));

    ivec2 p2 = ivec2(uv * vec2(imageSize(gDepthMip2)));
    float d2 = imageLoad(gDepthMip2, clamp(p2, ivec2(0), max(imageSize(gDepthMip2) - 1, ivec2(0)))).r;
    if (level < 2.5) return mix(d1, d2, clamp(level - 1.0, 0.0, 1.0));

    ivec2 p3 = ivec2(uv * vec2(imageSize(gDepthMip3)));
    float d3 = imageLoad(gDepthMip3, clamp(p3, ivec2(0), max(imageSize(gDepthMip3) - 1, ivec2(0)))).r;
    return mix(d2, d3, clamp(level - 2.0, 0.0, 1.0));
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(gReflection);
    if (pix.x >= size.x || pix.y >= size.y) {
        return;
    }

    vec3 curSpec = imageLoad(gReflection, pix).rgb;
    float curDepth = imageLoad(gDepth, pix).r;
    vec4 nPack = imageLoad(gNormal, pix);
    vec3 curN = normalize(nPack.xyz + 1e-6);
    float rough = clamp(nPack.w, 0.0, 1.0);

    bool noSurface = (length(nPack.xyz) < 1e-4) || (curDepth <= 1e-6);
    if (noSurface || pc.reset > 0.5 || rough > 0.95) {
        imageStore(gOut, pix, vec4(curSpec, 1.0));
        return;
    }

    vec2 motionPx = imageLoad(gMotion, pix).xy;
    float motionLen = length(motionPx);
    vec2 prevUv = (vec2(pix) + 0.5 - motionPx) * vec2(pc.invW, pc.invH);
    bool offscreen = any(lessThan(prevUv, vec2(0.0))) || any(greaterThanEqual(prevUv, vec2(1.0)));

    vec3 histSpec = curSpec;
    float histCount = 0.0;
    if (!offscreen) {
        vec2 prevPx = prevUv * vec2(size) - 0.5;
        ivec2 i0 = ivec2(floor(prevPx));
        vec2 f = prevPx - vec2(i0);
        ivec2 c00 = clamp(i0, ivec2(0), size - 1);
        ivec2 c10 = clamp(i0 + ivec2(1, 0), ivec2(0), size - 1);
        ivec2 c01 = clamp(i0 + ivec2(0, 1), ivec2(0), size - 1);
        ivec2 c11 = clamp(i0 + ivec2(1, 1), ivec2(0), size - 1);
        vec4 h00 = imageLoad(gHistory, c00);
        vec4 h10 = imageLoad(gHistory, c10);
        vec4 h01 = imageLoad(gHistory, c01);
        vec4 h11 = imageLoad(gHistory, c11);
        histSpec = mix(mix(h00.rgb, h10.rgb, f.x), mix(h01.rgb, h11.rgb, f.x), f.y);
        histCount = mix(mix(h00.a, h10.a, f.x), mix(h01.a, h11.a, f.x), f.y);

        // Full-res + hierarchy depth tests.
        float histDepth0 = imageLoad(gDepth, c00).r;
        float histDepthH = sampleDepthHierarchy(prevUv, motionLen);
        float depthErr0 = abs(curDepth - histDepth0) / max(curDepth, 1e-3);
        float depthErrH = abs(curDepth - histDepthH) / max(curDepth, 1e-3);
        float depthErr = min(depthErr0, depthErrH);

        float ndv = abs(curN.z);
        float thresh = mix(pc.depthThreshold * 4.0, pc.depthThreshold, clamp(ndv, 0.0, 1.0));
        thresh *= mix(0.5, 1.0, rough); // glossy: tighter
        // Large motion: slightly looser via hierarchy trust.
        thresh *= mix(1.0, 1.35, clamp(motionLen * 0.02, 0.0, 1.0));
        if (depthErr > thresh) {
            histCount = 0.0;
            histSpec = curSpec;
        }
        vec3 histN = normalize(imageLoad(gNormal, c00).xyz + 1e-6);
        if (dot(curN, histN) < 0.7) {
            histCount = 0.0;
            histSpec = curSpec;
        }
    }

    // 3x3 neighbourhood clamp (anti-ghost) with roughness-expanded box.
    vec3 nMin = curSpec;
    vec3 nMax = curSpec;
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            vec3 s = imageLoad(gReflection, clamp(pix + ivec2(dx, dy), ivec2(0), size - 1)).rgb;
            nMin = min(nMin, s);
            nMax = max(nMax, s);
        }
    }
    float expand = mix(0.02, 0.12, rough);
    histSpec = clamp(histSpec, nMin - expand, nMax + expand);

    float alpha = histCount < 1.0 ? 1.0 : mix(0.25, 0.08, clamp(histCount / 16.0, 0.0, 1.0));
    // Mirror-like: more temporal trust; rough: more current.
    alpha = mix(alpha, min(alpha + 0.1, 0.45), rough);

    vec3 outSpec = mix(histSpec, curSpec, alpha);
    outSpec = min(max(outSpec, vec3(0.0)), vec3(32.0));
    float outCount = min(histCount + 1.0, 64.0);
    imageStore(gOut, pix, vec4(outSpec, outCount));
}
