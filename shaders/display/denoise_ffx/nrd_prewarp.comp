#version 460
//
// NRD pre-warp pass — Option (b) for per-tile jitter reprojection correction.
//
// Why: world.rgen applies per-tile jitter (8x8 tiles, ±0.5 sub-pixel step) to the
// primary ray, but NRD's reprojection uses only the frame-global `cameraJitter`
// constant. Without correction, NRD's `prevUV = currentUV + mvec - (jitter -
// jitterPrev)` samples the previous frame at the wrong sub-pixel offset whenever
// the per-tile pattern changes between frames (which it does every frame; the
// pattern includes pc.frameIndex in the hash). The residual error causes subtle
// ghosting under camera motion — most visible on high-contrast edges.
//
// What: re-sample the current frame's NRD input (nrdDiff / nrdSpec) at
// `uv - tileJitter/size`. The output represents the radiance at the unjittered
// pixel position, so NRD's internal reproject math lines up perfectly. Equivalent
// to "pre-warping NRD's history one frame forward" without touching NRD's internal
// permanentPool (which the API does not expose for direct write).
//
// Cost: 1 R8G8 fetch + 2 RGBA16F bilinear samples per output pixel. At 1920x1080
// render res that's ~16 MB of input read + ~32 MB of write = ~48 MB per frame.
// On a modern GPU this is bandwidth-bound at <0.1 ms. Negligible vs the rest
// of the NRD pipeline (REBLUR is several MB per pass × ~5 passes).
//
// Layout:
//   in 0..1: jitterGuide sampler (R8G8)  - the per-tile offset written by world.rgen
//   in 2..3: inDiff, inSpec samplers     - current frame's NRD input (RGBA16F + hitDist.a)
//   out 4..5: outDiff, outSpec storage   - pre-warped NRD input, fed to NRD dispatch
//
// Push constants: vec2 size (render res). 8 bytes total.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D jitterGuide;
layout(set = 0, binding = 1) uniform sampler2D inDiff;
layout(set = 0, binding = 2) uniform sampler2D inSpec;

layout(set = 0, binding = 3, rgba16f) writeonly uniform image2D outDiff;
layout(set = 0, binding = 4, rgba16f) writeonly uniform image2D outSpec;

layout(push_constant) uniform Push {
    vec2  size;
    float _pad0;
    float _pad1;
} pc;

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sizeI = ivec2(pc.size);
    if (pix.x >= sizeI.x || pix.y >= sizeI.y) {
        return;
    }

    vec2 uv = (vec2(pix) + 0.5) / pc.size;

    // Read per-tile offset. World.rgen encoded as (offset + 0.5) into [0, 1]; we
    // subtract 0.5 to recover the [-0.5, +0.5] render-pixel range. With the
    // current 1/8 step scheme the value sits in roughly [-0.055, +0.055].
    vec2 guideVal = texture(jitterGuide, uv).rg;
    vec2 tileOffset = guideVal - 0.5;

    // Reverse the per-tile offset applied by world.rgen: sample the input at
    // `uv - tileOffset/size` (i.e. the position the unjittered pixel would map to
    // in the jittered radiance). The output of this pass represents the radiance
    // at the unjittered pixel position, so NRD's internal reproject math (which
    // is told the unjittered pixel position via `cameraJitter`) lines up.
    //
    // Clamp to [0, 1] to avoid sampling outside the render target at the edges.
    // The disocclusion mask at the screen border is high anyway, so the corner
    // clamp is invisible.
    vec2 sampleUV = clamp(uv - tileOffset / pc.size, vec2(0.0), vec2(1.0));

    vec4 diffSample = texture(inDiff, sampleUV);
    vec4 specSample = texture(inSpec, sampleUV);

    // NRD wants positive linear hit distance in the alpha channel. The prewarp
    // is a sub-pixel re-sample; the hit distance is preserved by the bilinear
    // filter (no need to clamp or transform it). The clamp/NaN guard in
    // prepare_nrd_inputs already produced clean values here.
    imageStore(outDiff, pix, diffSample);
    imageStore(outSpec, pix, specSample);
}
