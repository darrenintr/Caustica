// FidelityFX Shadow Denoiser — temporal reproject + local moments (Caustica-hosted).
// Anti-ghost first: contact shadows of moving entities (player/mobs) must not leave
// dark trails. History is useful only for static geometry under low motion.
// Outputs rg16f: r=shadow visibility [0,1], g=temporal count 0..16.
// Variance/mean are re-derived from 3x3 moments downstream (spatial pass).
#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Shadow moments (VRAM-first layout, 2026-09): rg16f plates
// (r=shadow visibility [0,1], g=temporal count) at 4 B/px instead of
// rgba16f 8 B/px. Variance/mean are re-derived from 3x3 moments each dispatch.
layout(binding = 0, rg16f) readonly  uniform image2D gShadowDense; // r=raw shadow, g=count seed
layout(binding = 1, r32f)    readonly  uniform image2D gDepth;
layout(binding = 2, rgba16f) readonly  uniform image2D gNormal;
layout(binding = 3, rgba16f) readonly  uniform image2D gMotion;
layout(binding = 4, rg16f) readonly  uniform image2D gHistoryShadow;
layout(binding = 5, rg16f) writeonly uniform image2D gOut;
// Optional packed hitmask (tiles). Used for cheap local stats when available.
layout(binding = 6, r32ui)   readonly  uniform uimage2D gHitMask;

layout(push_constant) uniform Push {
    float invW;
    float invH;
    float depthThreshold;
    float reset; // 1 = hard cut
} pc;

float fetchShadow(ivec2 p, ivec2 size) {
    p = clamp(p, ivec2(0), size - 1);
    return imageLoad(gShadowDense, p).r;
}

float fetchDepth(ivec2 p, ivec2 size) {
    p = clamp(p, ivec2(0), size - 1);
    return imageLoad(gDepth, p).r;
}

vec3 fetchNormal(ivec2 p, ivec2 size) {
    p = clamp(p, ivec2(0), size - 1);
    return normalize(imageLoad(gNormal, p).xyz + 1e-6);
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(gShadowDense);
    if (pix.x >= size.x || pix.y >= size.y) {
        return;
    }

    float curShadow = fetchShadow(pix, size);
    float curDepth = fetchDepth(pix, size);
    vec3 curN = fetchNormal(pix, size);

    bool noSurface = (length(imageLoad(gNormal, pix).xyz) < 1e-4) || (curDepth <= 1e-6);
    if (noSurface || pc.reset > 0.5) {
        imageStore(gOut, pix, vec4(curShadow, 1.0, 0.0, 0.0));
        return;
    }

    // Tight 3x3 neighborhood only — wide kernels smear player contact shadows into umbra ghosts.
    float nMin = curShadow;
    float nMax = curShadow;
    float sum = 0.0;
    float wSum = 0.0;
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            float s = fetchShadow(pix + ivec2(dx, dy), size);
            nMin = min(nMin, s);
            nMax = max(nMax, s);
            sum += s;
            wSum += 1.0;
        }
    }
    float mean = sum / max(wSum, 1.0);

    // ---- Reproject history ----
    vec2 motionPx = imageLoad(gMotion, pix).xy;
    float motionLen = length(motionPx);
    // Fast camera/entity motion: drop history entirely (no prev-depth buffer to disocclude cleanly).
    bool motionReject = motionLen > 2.5;

    // gMotion is previous - current in render pixels, so history is at current + motion.
    vec2 prevUv = (vec2(pix) + 0.5 + motionPx) * vec2(pc.invW, pc.invH);
    bool offscreen = any(lessThan(prevUv, vec2(0.0))) || any(greaterThanEqual(prevUv, vec2(1.0)));

    float histShadow = curShadow;
    float histCount = 0.0;
    if (!offscreen && !motionReject) {
        vec2 prevPx = prevUv * vec2(size) - 0.5;
        ivec2 i0 = ivec2(floor(prevPx));
        vec2 f = prevPx - vec2(i0);
        ivec2 c00 = clamp(i0, ivec2(0), size - 1);
        ivec2 c10 = clamp(i0 + ivec2(1, 0), ivec2(0), size - 1);
        ivec2 c01 = clamp(i0 + ivec2(0, 1), ivec2(0), size - 1);
        ivec2 c11 = clamp(i0 + ivec2(1, 1), ivec2(0), size - 1);
        float h00 = imageLoad(gHistoryShadow, c00).r;
        float h10 = imageLoad(gHistoryShadow, c10).r;
        float h01 = imageLoad(gHistoryShadow, c01).r;
        float h11 = imageLoad(gHistoryShadow, c11).r;
        histShadow = mix(mix(h00, h10, f.x), mix(h01, h11, f.x), f.y);
        float c00n = imageLoad(gHistoryShadow, c00).g;
        float c10n = imageLoad(gHistoryShadow, c10).g;
        float c01n = imageLoad(gHistoryShadow, c01).g;
        float c11n = imageLoad(gHistoryShadow, c11).g;
        histCount = mix(mix(c00n, c10n, f.x), mix(c01n, c11n, f.x), f.y);

        // Current-frame depth at reprojected UV is only a proxy (no prev depth). Keep it tight.
        float histDepth = fetchDepth(c00, size);
        float depthErr = abs(curDepth - histDepth) / max(curDepth, 1e-3);
        float ndv = abs(curN.z);
        float thresh = mix(pc.depthThreshold * 2.0, pc.depthThreshold * 0.75, clamp(ndv, 0.0, 1.0));
        if (depthErr > thresh) {
            histCount = 0.0;
            histShadow = curShadow;
        }
        vec3 histN = fetchNormal(c00, size);
        if (dot(curN, histN) < 0.7) {
            histCount = 0.0;
            histShadow = curShadow;
        }
        // Hard anti-ghost: history much darker than current = leftover contact shadow of a mover.
        if ((curShadow - histShadow) > 0.25) {
            histCount = 0.0;
            histShadow = curShadow;
        }
        // History much brighter than current on a hard umbra is usually wrong too (flicker),
        // but prefer a short blend rather than full reject so static penumbra can settle.
        if ((histShadow - curShadow) > 0.45) {
            histCount *= 0.25;
            histShadow = mix(histShadow, curShadow, 0.65);
        }
    } else {
        histCount = 0.0;
        histShadow = curShadow;
    }

    // Neighborhood clamp — tight box around current sample + 3x3 min/max.
    // Do NOT bias dark: that turns player trails into long black ghosts.
    float nmin = min(nMin, curShadow) - 0.02;
    float nmax = max(nMax, curShadow) + 0.02;
    // History may not darken a currently-lit pixel (anti-ghost of movers).
    nmin = max(nmin, curShadow - 0.12);
    // History may not brighten a currently-shadowed pixel by much (preserve contact umbra).
    nmax = min(nmax, curShadow + 0.10);
    float shadowClamped = clamp(histShadow, nmin, nmax);

    // alpha = weight of CURRENT. Keep temporal mild — FFX residual bilateral cleans GI.
    // (No variance term: the rg16f plates carry shadow+count only; the count
    // gate below is the convergence signal.)
    float alpha;
    if (histCount < 1.0) {
        alpha = 1.0;
    } else {
        // count 1..12 → alpha 0.55..0.22 (never stickier than 0.22)
        alpha = mix(0.55, 0.22, clamp(histCount / 12.0, 0.0, 1.0));
    }
    // Motion / local disagreement → trust current more.
    alpha = mix(alpha, 0.85, clamp(motionLen * 0.35, 0.0, 1.0));
    alpha = mix(alpha, 0.80, clamp(abs(curShadow - mean) * 2.5, 0.0, 1.0));
    alpha = clamp(alpha, 0.0, 1.0);

    float outShadow = mix(shadowClamped, curShadow, alpha);
    // Final safety: never leave a dark trail on a lit sample.
    outShadow = max(outShadow, curShadow - 0.08);
    outShadow = min(outShadow, curShadow + 0.12);
    outShadow = clamp(outShadow, 0.0, 1.0);

    float outCount = min(histCount + 1.0, 16.0);
    imageStore(gOut, pix, vec4(outShadow, outCount, 0.0, 0.0));
}
