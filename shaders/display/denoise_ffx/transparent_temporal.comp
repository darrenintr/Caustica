// Temporal accumulation for transparent materials with aggressive disocclusion detection.
// Rejects history on depth/normal mismatch to avoid ghost trails from moving water/glass.
#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba16f) readonly uniform image2D gSpatialFiltered;
layout(binding = 1, r32f) readonly uniform image2D gDepth;
layout(binding = 2, rgba16f) readonly uniform image2D gMotion;
layout(binding = 3, r8) readonly uniform image2D gTransparencyMask;
layout(binding = 4, rgba16f) uniform image2D gHistoryColor;  // read+write
layout(binding = 5, r32f) uniform image2D gHistoryDepth;     // read+write
layout(binding = 6, rgba16f) writeonly uniform image2D gOutColor;

layout(push_constant) uniform Push {
    float mvScaleX;
    float mvScaleY;
    float temporalAlpha;           // 0.35 = keep 35% history (balanced for transparent)
    float disocclusionThreshold;   // 0.08 = tight depth check
} pc;

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(gOutColor);
    if (pix.x >= size.x || pix.y >= size.y) {
        return;
    }

    float mask = imageLoad(gTransparencyMask, pix).r;
    vec3 current = imageLoad(gSpatialFiltered, pix).rgb;

    // If not transparent (mask < 0.5), pass through spatial result
    if (mask < 0.5) {
        imageStore(gOutColor, pix, vec4(current, 1.0));
        return;
    }

    float currentDepth = imageLoad(gDepth, pix).r;

    // Read motion vector and reproject to history
    vec2 motion = imageLoad(gMotion, pix).rg;
    vec2 uv = (vec2(pix) + 0.5) / vec2(size);
    vec2 historyUV = uv - vec2(motion.x * pc.mvScaleX, motion.y * pc.mvScaleY);
    ivec2 historyPix = ivec2(historyUV * vec2(size));

    // Out of bounds or first frame: no history
    if (historyPix.x < 0 || historyPix.x >= size.x ||
        historyPix.y < 0 || historyPix.y >= size.y ||
        pc.temporalAlpha < 0.01) {
        imageStore(gOutColor, pix, vec4(current, 1.0));
        imageStore(gHistoryColor, pix, vec4(current, 1.0));
        imageStore(gHistoryDepth, pix, vec4(currentDepth, 0.0, 0.0, 0.0));
        return;
    }

    // Fetch history
    vec3 history = imageLoad(gHistoryColor, historyPix).rgb;
    float historyDepth = imageLoad(gHistoryDepth, historyPix).r;

    // Disocclusion test: reject history if depth changed significantly
    // (tight threshold for transparent materials to avoid ghost trails)
    float depthDelta = abs(currentDepth - historyDepth) / max(currentDepth, 1e-4);
    bool disoccluded = depthDelta > pc.disocclusionThreshold;

    // Luminance-based rejection: detect lighting changes (day/night transitions)
    float currentLuma = dot(current, vec3(0.299, 0.587, 0.114));
    float historyLuma = dot(history, vec3(0.299, 0.587, 0.114));
    float lumaDelta = abs(currentLuma - historyLuma) / max(historyLuma, 0.01);
    bool lightingChanged = lumaDelta > 0.3;  // 30% luminance change = reject history (sensitive)

    // Temporal blend
    vec3 result;
    if (disoccluded || lightingChanged) {
        // Disoccluded or lighting changed: use current frame only
        result = current;
    } else {
        // Accumulate: blend current with history
        // Mix in a bit of ambient/diffuse to reduce specular noise
        float ambientFactor = 0.15;  // 15% ambient floor to mask fireflies
        vec3 ambient = current * ambientFactor;
        result = mix(current, history, pc.temporalAlpha) + ambient * (1.0 - pc.temporalAlpha);
    }

    // Clamp result to reasonable range (firefly suppression)
    result = clamp(result, vec3(0.0), vec3(10.0));

    imageStore(gOutColor, pix, vec4(result, 1.0));
    imageStore(gHistoryColor, pix, vec4(result, 1.0));
    imageStore(gHistoryDepth, pix, vec4(currentDepth, 0.0, 0.0, 0.0));
}
