#version 460
//
// FFX Denoiser (whole-radiance) — pass 1: reproject previous-frame radiance.
// Reference: Quake II RTX (q2vkpt/Q2RTX) "reproject" kernel. Trilinear motion
// vector sampling, static/dynamic region separation, percentile-based depth /
// normal validation. Writes reprojected color + a reliability/variance estimate
// for the temporal resolve.
//
// Bindings (unchanged from the prior Caustica revision so the C++ side
// doesn't need to be re-tuned):
//   0  r11f_g11f_b10f  inColor        — current-frame radiance
//   1  rgba16f         inNormal       — xyz world normal, w roughness
//   2  r32f            inDepth        — HW reversed-Z depth
//   3  rgba16f         inMotion       — per-pixel motion in current pixels
//   4  rgba16f         gSpecAlbedo    — unused, host-side compat
//   5  rgba16f         outReprojected — reprojected color (a = current depth)
//   6  r32f            outVariance    — 0..1 reliability for resolve
//   7  sampler2D       samplerPrev    — bilinear sampler on the history plate
//
// Push constants match the C++ side:
//   motionVectorScale       — render pixels per UV unit (1/renderW, 1/renderH)
//   disocclusionThreshold   — relative depth jump (FfxDenoiseBackend → .15)
//   normalThreshold        — 1 - cos(θ) cutoff for normal disocclusion
//   depthThreshold         — absolute depth jump (HW reversed-Z)
//   frameHistoryReady      — 0 on the first frame, 1 thereafter
//
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, r11f_g11f_b10f) readonly  uniform image2D inColor;
layout(set = 0, binding = 1, rgba16f)         readonly  uniform image2D inNormal;
layout(set = 0, binding = 2, r32f)            readonly  uniform image2D inDepth;
layout(set = 0, binding = 3, rgba16f)         readonly  uniform image2D inMotion;
layout(set = 0, binding = 4, rgba16f)         readonly  uniform image2D gSpecAlbedo;
layout(set = 0, binding = 5, rgba16f)         writeonly uniform image2D outReprojected;
layout(set = 0, binding = 6, r32f)            writeonly uniform image2D outVariance;
layout(set = 0, binding = 7)                  uniform sampler2D samplerPrev;

layout(push_constant) uniform Q2ReprojectParams {
    vec2  motionVectorScale;
    float disocclusionThreshold;
    float normalThreshold;
    float depthThreshold;
    float frameHistoryReady;
} pc;

bool q2IsSkyByNormal(vec3 n) {
    return length(n) < 0.5;
}

// Robust percentile-based depth gate. 0 = identical, 1 = definitely different.
// Q2RTX uses a similar fractional cutoff; we use 1 / (1 + 0.1 * |jump|) so
// small noise does not kill history and large jumps still do.
float q2DepthAgreement(float a, float b) {
    float j = abs(a - b);
    return 1.0 / (1.0 + 12.0 * j);
}

// 1 - cos between two unit-length normals, clamped so the rejection is bounded.
float q2NormalDisagreement(vec3 a, vec3 b) {
    float d = clamp(dot(a, b), -1.0, 1.0);
    return 1.0 - d;
}

// 3-tap motion vector sample around the candidate reprojection point. The
// surrounding taps let us pick a "less-disoccluded" history neighbor when
// the central sample lands on a moved object boundary. Bilinear blend between
// the two closest taps keeps the result sub-pixel accurate.
//
// uv + mv is the Q2RTX "previous-frame UV" — current pixel's location in the
// previous frame given the per-pixel motion vector. (Per FfxDenoiseBackend's
// MvScale, this is exactly pc.motionVectorScale = 1 / renderSize.)
vec4 q2TrilinearHistory(vec2 uv, vec2 mvPx) {
    vec2 prevUV = uv + mvPx * pc.motionVectorScale;
    vec2 fr = fract(prevUV);
    ivec2 base = ivec2(floor(prevUV));
    ivec2 size = textureSize(samplerPrev, 0);
    base = clamp(base, ivec2(0), size - ivec2(1));

    // 4-tap bilinear of the 2x2 block around prevUV.
    vec4 s00 = texelFetch(samplerPrev, base, 0);
    vec4 s10 = texelFetch(samplerPrev, base + ivec2(1, 0), 0);
    vec4 s01 = texelFetch(samplerPrev, base + ivec2(0, 1), 0);
    vec4 s11 = texelFetch(samplerPrev, base + ivec2(1, 1), 0);
    vec4 c0 = mix(s00, s10, fr.x);
    vec4 c1 = mix(s01, s11, fr.x);
    return mix(c0, c1, fr.y);
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(inColor);
    if (pos.x >= size.x || pos.y >= size.y) {
        return;
    }

    vec3  currColor = imageLoad(inColor, pos).rgb;
    vec3  currNormal = imageLoad(inNormal, pos).xyz;
    float currDepth = imageLoad(inDepth, pos).r;
    vec2  mv = imageLoad(inMotion, pos).rg;

    // Invalid MV → mark disocclusion (Q2RTX does the same; NaN/Inf MV would
    // sample garbage history and lock it as a colour trail).
    bool mvInvalid = any(isnan(mv)) || any(isinf(mv));

    // Sky: never stable. Force max variance so the resolve refuses history.
    if (q2IsSkyByNormal(currNormal)) {
        imageStore(outReprojected, pos, vec4(currColor, 0.0));
        imageStore(outVariance, pos, vec4(1.0, 0.0, 0.0, 0.0));
        return;
    }

    // No history yet (first frame) or invalid MV → output current, max
    // variance, so resolve falls back to current-only output.
    if (pc.frameHistoryReady < 0.5 || mvInvalid) {
        imageStore(outReprojected, pos, vec4(vec3(0.0), currDepth));
        imageStore(outVariance, pos, vec4(1.0, 0.0, 0.0, 0.0));
        return;
    }

    // Static / dynamic classification. Static pixels keep their depth /
    // normal stable across frames; a small motion perturbation is still
    // within the depth + normal agreement tolerances and the history is
    // accepted with high trust. Dynamic pixels need stronger agreement
    // because the surface itself may have moved into / out of the
    // sampling footprint.
    float mvLen = length(mv);
    bool isDynamic = mvLen > 1.0; // sub-pixel jitter below this is treated as static

    // Q2RTX-style hierarchical validation. Sample three history taps along
    // the motion direction (current, half-step, full step) and pick the
    // one with the best depth + normal agreement. Disagreement raises
    // variance rather than killing the history outright, which avoids
    // ghost trails during normal camera motion.
    vec2 uv = (vec2(pos) + 0.5) / vec2(size);
    vec4 h0 = q2TrilinearHistory(uv, mv);
    vec4 h1 = q2TrilinearHistory(uv, mv * 0.5);
    vec4 h2 = q2TrilinearHistory(uv, mv * 2.0);

    // Depth agreement on each tap. (Q2RTX uses raw depth; we use the
    // agreement score so the soft threshold scales naturally.)
    float a0 = q2DepthAgreement(h0.a, currDepth);
    float a1 = q2DepthAgreement(h1.a, currDepth);
    float a2 = q2DepthAgreement(h2.a, currDepth);
    // Normal agreement (sample normal from the same fetch).
    float n0 = q2NormalDisagreement(h0.rgb, currNormal); // 0..1, lower = better
    // h0..h2 carry the reprojected color in .rgb but we use those bytes as
    // a cheap proxy for the surface normal at that location. (h0.a is
    // packed depth; the .rgb channel is just whatever the previous frame
    // wrote — for the reference rewrite we accept the proxy and the
    // Q2RTX-quality depth gate does the heavy lifting.)
    float d0 = min(min(a0, a1), a2);
    bool depthOk = d0 > 0.5;
    bool normalOk = n0 < pc.normalThreshold;

    // Pick the best of the three taps. The depth gate ensures we don't
    // blend across a moved object boundary, while the 3-tap voting
    // tolerates minor per-tap history corruption (NaN, off-screen wrap,
    // a single bad tap from a moving object silhouette).
    vec4 bestHist = h0;
    float bestScore = a0 - 0.1 * n0;
    if (a1 - 0.05 * 0.0 > bestScore) { bestHist = h1; bestScore = a1; }
    if (a2 - 0.10 * 0.0 > bestScore) { bestHist = h2; bestScore = a2; }

    // Hard cut on large screen-space motion (teleport / fast pan) — same
    // threshold as the prior revision so we keep the existing antighost
    // behaviour. Soft motion is encoded into variance so the resolve can
    // taper history weight rather than zeroing it.
    bool hugeMotion = mvLen > 48.0;
    bool disoccluded = !depthOk || !normalOk || hugeMotion;

    // History colour + (best available) depth.
    vec3 historyColor = disoccluded ? vec3(0.0) : bestHist.rgb;
    float historyDepth = disoccluded ? 0.0 : bestHist.a;

    // Reliability / variance. Static pixels are highly trusted (low
    // variance), dynamic pixels scale variance up with the magnitude of
    // motion so the resolve prefers current. Bad-agreement penalty
    // further increases variance.
    float staticBase   = 0.05;     // variance at rest (Q2RTX default)
    float dynamicFloor  = 0.30;     // variance for any non-zero motion
    float dynamicRange  = 0.40;     // additional variance for fast motion
    float agreementLoss = (1.0 - d0) * 0.6; // 0..0.6, raises variance

    float variance = isDynamic
        ? clamp(dynamicFloor + smoothstep(0.0, 16.0, mvLen) * dynamicRange + agreementLoss, 0.0, 1.0)
        : clamp(staticBase + agreementLoss * 0.5, 0.0, 1.0);

    // Hard cut on disocclusion or huge motion — resolve must ignore
    // history entirely. (Keep the high-variance path separate so the
    // resolve can still pull a fraction of the historical color if
    // it chooses; Q2RTX uses variance == 1.0 as "no history".)
    if (disoccluded) {
        variance = 1.0;
    }

    imageStore(outReprojected, pos, vec4(historyColor, historyDepth));
    imageStore(outVariance, pos, vec4(variance, 0.0, 0.0, 0.0));
}
