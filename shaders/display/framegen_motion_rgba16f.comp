#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D currentColor;
layout(set = 0, binding = 1) uniform sampler2D previousColor;
layout(set = 0, binding = 2, r32f) readonly uniform image2D currentDepth;
layout(set = 0, binding = 3, r32f) readonly uniform image2D previousDepth;
layout(set = 0, binding = 4, rgba16f) readonly uniform image2D motionVectors;
layout(set = 0, binding = 5, rgba16f) writeonly uniform image2D interpolatedColor;

layout(push_constant) uniform FrameGenParams {
    ivec2 outputSize;
    ivec2 motionDepthSize;
    float interpolationPoint;
    float motionScaleX;
    float motionScaleY;
    uint historyReady;
} pc;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, pc.outputSize))) {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / vec2(pc.outputSize);
    vec4 current = texture(currentColor, uv);
    if (pc.historyReady == 0u) {
        imageStore(interpolatedColor, pixel, vec4(current.rgb, 1.0));
        return;
    }

    ivec2 guidePixel = clamp(ivec2(uv * vec2(pc.motionDepthSize)), ivec2(0), pc.motionDepthSize - 1);
    vec2 motion = imageLoad(motionVectors, guidePixel).xy * vec2(pc.motionScaleX, pc.motionScaleY);
    if (any(isnan(motion)) || any(isinf(motion))) {
        imageStore(interpolatedColor, pixel, vec4(current.rgb, 1.0));
        return;
    }

    vec2 previousUv = uv + motion; // Caustica guide convention: previous - current in UV space.
    bool inBounds = all(greaterThanEqual(previousUv, vec2(0.0)))
            && all(lessThan(previousUv, vec2(1.0)));
    if (!inBounds) {
        imageStore(interpolatedColor, pixel, vec4(current.rgb, 1.0));
        return;
    }

    ivec2 previousGuidePixel = clamp(ivec2(previousUv * vec2(pc.motionDepthSize)),
            ivec2(0), pc.motionDepthSize - 1);
    float zCurrent = imageLoad(currentDepth, guidePixel).r;
    float zPrevious = imageLoad(previousDepth, previousGuidePixel).r;
    float relativeDepthDelta = abs(zCurrent - zPrevious) / max(max(abs(zCurrent), abs(zPrevious)), 1.0e-3);
    bool disoccluded = relativeDepthDelta > 0.08 || abs(zCurrent - zPrevious) > 0.02;

    vec3 previous = texture(previousColor, previousUv).rgb;
    vec3 result = disoccluded
            ? current.rgb
            : mix(previous, current.rgb, clamp(pc.interpolationPoint, 0.0, 1.0));
    if (any(isnan(result)) || any(isinf(result))) {
        result = current.rgb;
    }
    imageStore(interpolatedColor, pixel, vec4(result, 1.0));
}
