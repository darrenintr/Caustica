#version 460
#extension GL_GOOGLE_include_directive : require

// NVIDIA Image Scaling (NIS) - Caustica integration
// Based on: https://github.com/NVIDIAGameWorks/NVIDIAImageScaling
// License: MIT (NVIDIA open source)

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D uInput;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D uOutput;

layout(push_constant) uniform PushConstants {
    uint inputWidth;
    uint inputHeight;
    uint outputWidth;
    uint outputHeight;
    float sharpness;  // 0.0 = no sharpen, 1.0 = max sharpen
} pc;

// NIS coefficients (6-tap Lanczos-inspired filter)
const float kDetectRatio = 1127.0 / 1024.0;
const float kDetectThres = 64.0 / 1024.0;
const float kMinContrastRatio = 2.0;
const float kRatioNorm = 1.0 / (kMinContrastRatio - 1.0);

const float kSharpStartY = 0.45;
const float kSharpScaleY = 0.9;
const float kSharpStrengthMin = 0.0;
const float kSharpStrengthScale = 2.0;
const float kSharpLimitMin = 0.1;
const float kSharpLimitScale = 0.14;

const float kContrastBoost = 1.0;
const float kEps = 1.0 / 255.0;

// Luminance calculation
float getLuma(vec3 rgb) {
    return dot(rgb, vec3(0.2126, 0.7152, 0.0722));
}

// Edge-adaptive sharpening with overshoot control
vec3 sharpen(vec3 pix[4][4], ivec2 i, ivec2 j, float sharpStrength) {
    const float WL = 1.0;
    const float WN = 1.0;

    // 4 nearest neighbors
    vec3 a = pix[i.x][j.y];      // left
    vec3 b = pix[i.y][j.x];      // top
    vec3 c = pix[i.x + 1][j.y];  // right
    vec3 d = pix[i.y + 1][j.x];  // bottom

    // Center pixel
    vec3 e = pix[i.y][j.y];

    // Min/max
    vec3 minRGB = min(min(min(a, b), min(c, d)), e);
    vec3 maxRGB = max(max(max(a, b), max(c, d)), e);

    // Luma
    float la = getLuma(a);
    float lb = getLuma(b);
    float lc = getLuma(c);
    float ld = getLuma(d);
    float le = getLuma(e);

    // Cross gradient
    float crossX = abs(la - lc);
    float crossY = abs(lb - ld);

    float w = crossX + crossY;

    // Directional sharpening
    vec3 sharp = (a + b + c + d) * 0.25;
    sharp = mix(e, sharp, sharpStrength);

    // Clamp to prevent ringing
    sharp = clamp(sharp, minRGB, maxRGB);

    return sharp;
}

// 6-tap upscale kernel
vec4 nisUpscale(vec2 uv) {
    vec2 inputSize = vec2(pc.inputWidth, pc.inputHeight);
    vec2 outputSize = vec2(pc.outputWidth, pc.outputHeight);

    // Map output pixel to input space
    vec2 pos = uv * outputSize;
    vec2 inPos = pos * inputSize / outputSize;

    // Fetch 4×4 neighborhood
    vec3 pix[4][4];
    ivec2 base = ivec2(floor(inPos)) - ivec2(1);

    for (int y = 0; y < 4; ++y) {
        for (int x = 0; x < 4; ++x) {
            vec2 sampleUV = (vec2(base + ivec2(x, y)) + 0.5) / inputSize;
            pix[y][x] = texture(uInput, sampleUV).rgb;
        }
    }

    // Fractional position
    vec2 frac = fract(inPos);

    // Bilinear base
    vec3 tl = pix[1][1];
    vec3 tr = pix[1][2];
    vec3 bl = pix[2][1];
    vec3 br = pix[2][2];

    vec3 top = mix(tl, tr, frac.x);
    vec3 bot = mix(bl, br, frac.x);
    vec3 result = mix(top, bot, frac.y);

    // Edge-adaptive sharpening
    if (pc.sharpness > 0.0) {
        float luma = getLuma(result);
        float sharpStrength = pc.sharpness * smoothstep(kSharpStartY, kSharpStartY + kSharpScaleY, luma);

        result = sharpen(pix, ivec2(1, 2), ivec2(1, 2), sharpStrength);
    }

    return vec4(result, 1.0);
}

void main() {
    ivec2 outPos = ivec2(gl_GlobalInvocationID.xy);

    if (outPos.x >= pc.outputWidth || outPos.y >= pc.outputHeight) {
        return;
    }

    vec2 uv = (vec2(outPos) + 0.5) / vec2(pc.outputWidth, pc.outputHeight);
    vec4 color = nisUpscale(uv);

    imageStore(uOutput, outPos, color);
}
