#version 460
// Radiance-style histogram: optional center metering so huge snow floors / sky
// don't fully dominate auto-exposure.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, set = 0, r11f_g11f_b10f) uniform readonly image2D colorImage;
layout(std430, binding = 1, set = 0) buffer Histogram {
    uint bins[256];
} hist;

layout(push_constant) uniform Push {
    int meteringMode;        // 0=global, 1=center
    float centerRegion;      // fraction of frame on each axis area (0..1), e.g. 0.5 = center 50% area
    float skyWeight;         // multiply contribution for near-black / sky-like (reserved, 1.0)
    float _pad;
} pc;

const float LOG_MIN = -12.0;
const float LOG_MAX = 12.0;
const float INV_LOG_RANGE = 1.0 / (LOG_MAX - LOG_MIN);

shared uint localBins[256];

void main() {
    uint localIdx = gl_LocalInvocationIndex;
    localBins[localIdx] = 0u;
    barrier();

    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(colorImage);
    if (pix.x < size.x && pix.y < size.y) {
        bool includePix = true;
        if (pc.meteringMode == 1) {
            float region = clamp(pc.centerRegion, 0.05, 1.0);
            float axis = sqrt(region);
            vec2 center = vec2(size) * 0.5;
            vec2 halfExtent = vec2(size) * 0.5 * axis;
            vec2 p = vec2(pix) + 0.5;
            includePix = all(greaterThanEqual(p, center - halfExtent))
                      && all(lessThan(p, center + halfExtent));
        }
        if (includePix) {
            vec3 rgb = max(imageLoad(colorImage, pix).rgb, vec3(0.0));
            float lum = dot(rgb, vec3(0.2126, 0.7152, 0.0722));
            float logLum = clamp(log2(max(lum, 1.0e-5)), LOG_MIN, LOG_MAX);
            uint bin = min(uint(floor((logLum - LOG_MIN) * INV_LOG_RANGE * 256.0)), 255u);
            atomicAdd(localBins[bin], 1u);
        }
    }

    barrier();
    uint count = localBins[localIdx];
    if (count > 0u) {
        atomicAdd(hist.bins[localIdx], count);
    }
}
