#version 460
// Radiance-style: average log-luminance between low/high histogram percentiles
// (exclude darkest voids AND brightest snow peaks), then middle-grey target.

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0, set = 0) readonly buffer Histogram {
    uint bins[256];
} hist;
layout(binding = 1, set = 0, r32f) uniform image2D exposureImage;
layout(std430, binding = 2, set = 0) buffer ExposureState {
    float previous;
    uint initialized;
} stateBuf;

layout(push_constant) uniform Push {
    float key;               // middle grey / key (Radiance middleGrey)
    float minEv;
    float maxEv;
    float adaptUp;
    float adaptDown;
    float frameTimeSeconds;
    float evBias;
    float lowPercent;        // e.g. 0.08 — drop darkest 8%
    float highPercent;       // e.g. 0.90 — drop brightest 10%
    float _pad0;
    float _pad1;
    float _pad2;
} pc;

const float LOG_MIN = -12.0;
const float LOG_MAX = 12.0;
const float LOG_STEP = (LOG_MAX - LOG_MIN) / 256.0;

float binCenter(uint bin) {
    return LOG_MIN + (float(bin) + 0.5) * LOG_STEP;
}

void main() {
    // Sum actual histogram samples (may be center-cropped; do NOT use full-frame pixelCount)
    uint total = 0u;
    for (uint i = 0u; i < 256u; ++i) {
        total += hist.bins[i];
    }

    float prev = stateBuf.initialized == 0u ? pc.key : max(stateBuf.previous, 1.0e-4);
    if (total == 0u) {
        stateBuf.previous = clamp(prev, exp2(pc.minEv), exp2(pc.maxEv));
        stateBuf.initialized = 1u;
        imageStore(exposureImage, ivec2(0), vec4(stateBuf.previous, 0.0, 0.0, 0.0));
        return;
    }

    float fTotal = float(total);
    float lo = clamp(pc.lowPercent, 0.0, 0.49);
    float hi = clamp(pc.highPercent, lo + 0.05, 1.0);
    uint lowCount = uint(floor(lo * fTotal));
    uint highCount = max(lowCount + 1u, uint(ceil(hi * fTotal)));

    uint cumulative = 0u;
    float weightedLogLum = 0.0;
    uint weightedCount = 0u;
    for (uint i = 0u; i < 256u; ++i) {
        uint count = hist.bins[i];
        uint start = cumulative;
        uint end = cumulative + count;
        uint takeStart = max(start, lowCount);
        uint takeEnd = min(end, highCount);
        if (takeEnd > takeStart) {
            uint take = takeEnd - takeStart;
            weightedLogLum += binCenter(i) * float(take);
            weightedCount += take;
        }
        cumulative = end;
        if (cumulative >= highCount) {
            break;
        }
    }

    float avgLogLum = weightedCount > 0u ? weightedLogLum / float(weightedCount) : 0.0;
    // Radiance: targetExposure = middleGrey / avgLum
    float avgLum = exp2(avgLogLum);
    float target = (pc.key / max(avgLum, 1e-6)) * exp2(pc.evBias);
    target = clamp(target, exp2(pc.minEv), exp2(pc.maxEv));

    float rate = target > prev ? pc.adaptUp : pc.adaptDown;
    float alpha = stateBuf.initialized == 0u ? 1.0 : 1.0 - exp(-pc.frameTimeSeconds / max(rate, 1.0e-4));
    float exposure = mix(prev, target, clamp(alpha, 0.0, 1.0));

    stateBuf.previous = exposure;
    stateBuf.initialized = 1u;
    imageStore(exposureImage, ivec2(0), vec4(exposure, 0.0, 0.0, 0.0));
}
