#version 460
// Post-display destroy-stage crack overlay.
//
// Runs AFTER path-trace / denoise / upscale / tonemap so dig cracks cannot poison NRD, FSR, or
// auto-exposure. Reconstructs camera-relative hit position from the RT reverse-Z depth guide
// (same convention as world.rgen: ndc.z = clip.z/clip.w, near=1 far=0) and multiplies only
// crack texels (alpha-gated) onto the final display LDR image.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, set = 0, rgba8) uniform image2D displayImage; // final LDR (or post-tonemap)
layout(binding = 1, set = 0, r32f) uniform readonly image2D depthImage; // render-res HW reverse-Z
layout(binding = 2, set = 0) uniform sampler2D crackAtlas; // one destroy_stage texture (rebound per block)

layout(push_constant) uniform Push {
    mat4 invViewProj;     // camera-relative inv(view*proj), matches world push invViewProj
    vec2 renderSize;
    vec2 displaySize;
    ivec4 blockPosSlot;   // xyz rebased block pos
    vec3 camOffset;       // camera in rebased world (cam - terrainOrigin)
    float _pad0;
} pc;

void main() {
    ivec2 dxy = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dsize = ivec2(pc.displaySize);
    if (dxy.x >= dsize.x || dxy.y >= dsize.y) {
        return;
    }

    // Display UV → render-res depth sample (nearest). Depth is written in render resolution.
    vec2 duv = (vec2(dxy) + 0.5) / pc.displaySize;
    ivec2 rxy = clamp(ivec2(floor(duv * pc.renderSize)), ivec2(0), ivec2(pc.renderSize) - 1);
    float depth = imageLoad(depthImage, rxy).r;
    // reverse-Z: sky/far ~ 0, near ~ 1. Skip empty / background.
    if (depth <= 1e-5 || depth >= 0.9999) {
        return;
    }

    // Reconstruct camera-relative world position.
    // world.rgen stores gDepth = clip.z / clip.w after curViewProj * vec4(hitCamRel,1).
    // With JOML-style perspective + reverse-Z, NDC is y-up; our framebuffer UV is y-down, so
    // flip Y when going UV → NDC. Then unproject with invViewProj.
    vec2 ndc = vec2(duv.x * 2.0 - 1.0, 1.0 - duv.y * 2.0);
    // Recover clip with w=1 first, then invViewProj expects the same clip space as world push.
    // For reverse-Z infinite projections, clip.w is view-space Z and ndc.z = clip.z/clip.w.
    // Using (ndc.xy, depth, 1) is the standard unproject for this pipeline's invViewProj.
    vec4 clip = vec4(ndc, depth, 1.0);
    vec4 worldH = pc.invViewProj * clip;
    if (abs(worldH.w) < 1e-6) {
        return;
    }
    vec3 hitCamRel = worldH.xyz / worldH.w;

    // Rebased absolute position (same space as terrain.block* and writeBreaking offsets).
    vec3 hitPos = pc.camOffset + hitCamRel;

    // Bias slightly toward the camera so face-adjacent samples stay inside the solid block
    // (same idea as the old rchit path's -n*0.01, but without needing the normal).
    vec3 towardCam = -normalize(hitCamRel + vec3(1e-6));
    ivec3 bpos = ivec3(floor(hitPos + towardCam * 0.02));
    if (!all(equal(bpos, pc.blockPosSlot.xyz))) {
        return;
    }

    vec3 local = hitPos - vec3(bpos);
    // Sheeted-decal style UV: project onto the face with the largest normal-ish extent.
    // Use distance-to-face-center axes as a cheap face selector (no normal buffer here).
    vec3 d = abs(local - 0.5);
    vec2 decalUv;
    if (d.x >= d.y && d.x >= d.z) {
        // ±X face: use Z/Y. Mirror Z on +X so cracks read consistently from both sides.
        decalUv = (local.x > 0.5) ? vec2(1.0 - local.z, local.y) : vec2(local.z, local.y);
    } else if (d.y >= d.z) {
        // ±Y face: use X/Z
        decalUv = (local.y > 0.5) ? vec2(local.x, 1.0 - local.z) : vec2(local.x, local.z);
    } else {
        // ±Z face: use X/Y. Mirror X on +Z.
        decalUv = (local.z > 0.5) ? vec2(1.0 - local.x, local.y) : vec2(local.x, local.y);
    }
    decalUv = clamp(decalUv, vec2(0.0), vec2(1.0));

    // Nearest sample of 16x16 destroy_stage art.
    ivec2 texSize = textureSize(crackAtlas, 0);
    ivec2 ip = clamp(ivec2(floor(decalUv * vec2(texSize))), ivec2(0), max(texSize - 1, ivec2(0)));
    vec4 crack = texelFetch(crackAtlas, ip, 0);
    float a = clamp(crack.a, 0.0, 1.0);
    if (a < 0.04) {
        return;
    }

    vec4 base = imageLoad(displayImage, dxy);
    // Vanilla destroy_stage: transparent bg + gray/black cracks. Multiply under alpha only.
    vec3 crackRgb = max(crack.rgb, vec3(0.08));
    vec3 outRgb = mix(base.rgb, base.rgb * crackRgb, a);
    imageStore(displayImage, dxy, vec4(outRgb, base.a));
}
