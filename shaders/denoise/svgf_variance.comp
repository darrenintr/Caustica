#version 460
#extension GL_GOOGLE_include_directive : require

// SVGF Step 2: Variance Estimation
// Compute spatial variance for edge-stopping in the wavelet filter

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D uColor;
layout(set = 0, binding = 1) uniform sampler2D uMoment;

layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D uVarianceOut;

layout(push_constant) uniform PushConstants {
    uvec2 resolution;
} pc;

float luminance(vec3 rgb) {
    return dot(rgb, vec3(0.2126, 0.7152, 0.0722));
}

void main() {
    ivec2 pixelPos = ivec2(gl_GlobalInvocationID.xy);
    if (pixelPos.x >= pc.resolution.x || pixelPos.y >= pc.resolution.y) {
        return;
    }

    vec2 uv = (vec2(pixelPos) + 0.5) / vec2(pc.resolution);

    // Sample current pixel
    vec3 color = texture(uColor, uv).rgb;
    vec4 moment = texture(uMoment, uv);
    float variance = moment.g;

    // Compute spatial variance in 7x7 window
    float sum = 0.0;
    float sumSq = 0.0;
    float count = 0.0;

    const int radius = 3;
    for (int y = -radius; y <= radius; ++y) {
        for (int x = -radius; x <= radius; ++x) {
            vec2 sampleUV = uv + vec2(x, y) / vec2(pc.resolution);
            if (sampleUV.x >= 0.0 && sampleUV.x <= 1.0 && sampleUV.y >= 0.0 && sampleUV.y <= 1.0) {
                vec3 sampleColor = texture(uColor, sampleUV).rgb;
                float luma = luminance(sampleColor);
                sum += luma;
                sumSq += luma * luma;
                count += 1.0;
            }
        }
    }

    float mean = sum / count;
    float spatialVariance = max(0.0, (sumSq / count) - (mean * mean));

    // Combine temporal and spatial variance
    float finalVariance = max(variance, spatialVariance);

    imageStore(uVarianceOut, pixelPos, vec4(color, finalVariance));
}
